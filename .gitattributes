# 默认交给 git 判断是不是文本文件
* text=auto

# Windows 原生脚本强制 CRLF（cmd.exe 对 LF 结尾的 .bat 会出问题）
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# 跨平台文件统一 LF，避免 diff 噪音
*.md    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.exe   binary
*.dll   binary
*.zip   binary
